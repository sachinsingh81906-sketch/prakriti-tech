  return {dashboard:"Command Center Dashboard",map:"Live Environmental Risk Map",nodes:"Sensor Node Management",
    intel:"Hazard Intelligence",alerts:"Alert Engine",rescue:"Rescue & Response",analytics:"Analytics",
    simulation:"Hardware Simulation Center",devices:"Device Management & Security",health:"System Health",settings:"Settings"}[id] || "";
}

