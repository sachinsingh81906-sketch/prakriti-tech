/* ================= HAZARD INTELLIGENCE ================= */
function IntelView({nodes}){
  const hazards = ["FLOOD","FIRE","AIR","LANDSLIDE"];
  return (
    <div style={{display:"flex",flexDirection:"column",gap:14}}>
      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:12}}>
        {hazards.map(h=>{
          const relevant = nodes.filter(n=>n.hazardScores && n.hazardScores[h]);
          const top = relevant.sort((a,b)=>(b.hazardScores[h]?.score||0)-(a.hazardScores[h]?.score||0))[0];
          const score = top ? top.hazardScores[h].score : 0;
          const level = levelFromScore(score);
          const Icon = HAZARD_ICON[h];
          return (
            <div key={h} className="psa-panel" style={{padding:14}}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
                <div style={{display:"flex",gap:7,alignItems:"center"}}><Icon size={16} color={LEVEL_COLOR[level]}/><b style={{fontSize:12.5}}>{HAZARD_LABEL[h]}</b></div>
                <span className={"badge "+LEVEL_BADGE[level]}>{level}</span>
              </div>
              <div className="mono" style={{fontSize:26,fontWeight:700,marginTop:8,color:LEVEL_COLOR[level]}}>{score}</div>
              <div style={{fontSize:11,color:"var(--muted)",marginTop:4}}>Peak node: {top?top.id:"—"}</div>
              {top && (
                <div style={{marginTop:8,display:"flex",flexDirection:"column",gap:3}}>
                  {top.hazardScores[h].factors.slice(0,3).map((f,i)=>(
                    <div key={i} style={{display:"flex",justifyContent:"space-between",fontSize:10.5,color:"var(--muted)"}}>
                      <span>{f.label}</span><span className="mono">+{f.contribution}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <div className="psa-panel" style={{padding:16}}>
        <PanelHeader title="Traditional IoT vs. Prakriti Sentinel AI Pipeline" />
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:16}}>
          <div className="psa-panel2" style={{padding:14}}>
            <div style={{fontSize:11.5,color:"var(--muted)",marginBottom:8,fontWeight:700}}>TRADITIONAL IoT</div>
            <PipelineRow steps={["Sense","Send","Display"]} color="var(--muted)"/>
            <p style={{fontSize:11.5,color:"var(--muted)",marginTop:10,lineHeight:1.6}}>
              A single sensor crossing a fixed threshold triggers an alert directly, with no cross-checking —
              prone to false alarms from a single faulty reading.
            </p>
          </div>
          <div className="psa-panel2" style={{padding:14}}>
            <div style={{fontSize:11.5,color:"var(--cyan)",marginBottom:8,fontWeight:700}}>PRAKRITI SENTINEL AI</div>
            <PipelineRow steps={["Sense","Validate","Understand","Predict","Localize","Alert","Act"]} color="var(--cyan)"/>
            <p style={{fontSize:11.5,color:"var(--muted)",marginTop:10,lineHeight:1.6}}>
              Readings pass through multi-node sensor fusion before AI risk scoring, giving explainable,
              confidence-rated alerts and a concrete response workflow.
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}
function PipelineRow({steps,color}){
  return <div style={{display:"flex",flexWrap:"wrap",gap:6,alignItems:"center"}}>
    {steps.map((s,i)=>(
      <React.Fragment key={s}>
        <span className="psa-panel2" style={{padding:"5px 10px",fontSize:11.5,fontWeight:600,color}}>{s}</span>
        {i<steps.length-1 && <ChevronRight size={13} color="var(--muted2)"/>}
      </React.Fragment>
    ))}
