}

/* ================= ALERTS ================= */
function AlertsView({alerts,canRespond,acknowledgeAlert,escalateAlert,resolveAlert}){
  if(!alerts.length) return <div className="psa-panel" style={{padding:14}}><EmptyState text="No alerts have been generated yet. Start a scenario in the Simulation Center."/></div>;
  return (
    <div style={{display:"flex",flexDirection:"column",gap:10}}>
      {alerts.map(a=>(
        <div key={a.id} className="psa-panel" style={{padding:16}}>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start"}}>
            <div>
              <div style={{display:"flex",gap:8,alignItems:"center",marginBottom:6}}>
                <span className={"badge "+LEVEL_BADGE[a.level]}>{a.level} {HAZARD_LABEL[a.hazard]} ALERT</span>
                <span style={{fontSize:11,color:"var(--muted2)"}}>{a.id} · {a.timestamp}</span>
                <span className={"badge "+(a.status==="ACTIVE"?"b-warning":a.status==="ACKNOWLEDGED"?"b-watch":"b-safe")}>{a.status}</span>
              </div>
              <div style={{fontSize:13,fontWeight:600}}>Location: {a.location} · Node {a.nodeId}</div>
              <div style={{fontSize:12,marginTop:2}}>Risk: <span className="mono" style={{color:LEVEL_COLOR[a.level]}}>{a.riskScore}/100</span> · Confidence: <span className="mono">{a.confidence}%</span></div>
              <div style={{fontSize:12,color:"var(--muted)",marginTop:4}}>Reason: {a.reason}</div>
              <div style={{marginTop:8}}>
                <div style={{fontSize:11.5,fontWeight:700,marginBottom:4}}>Recommended Action</div>
                <ol style={{margin:0,paddingLeft:18,fontSize:11.5,color:"var(--muted)",lineHeight:1.7}}>
                  {a.recommendedActions.map((r,i)=><li key={i}>{r}</li>)}
                </ol>
              </div>
            </div>
            <div style={{display:"flex",flexDirection:"column",gap:6,minWidth:130}}>
              <button className="psa-btn" disabled={!canRespond||a.status!=="ACTIVE"} onClick={()=>acknowledgeAlert(a.id)}>Acknowledge</button>
              <button className="psa-btn psa-btn-danger" disabled={!canRespond||a.level==="CRITICAL"||a.status==="RESOLVED"} onClick={()=>escalateAlert(a.id)}>Escalate</button>
              <button className="psa-btn psa-btn-safe" disabled={!canRespond||a.status==="RESOLVED"} onClick={()=>resolveAlert(a.id)}>Resolve</button>
            </div>
          </div>
        </div>
      ))}
    </div>
  );
}

/* ================= RESCUE / RESPONSE ================= */
function RescueView({incidents,nodes,safeZones,canRespond,startResponse,advanceWorkflow,responseWorkflows,nearestSafeZone,WORKFLOW_STEPS}){
  if(!incidents.length) return <div className="psa-panel" style={{padding:14}}><EmptyState text="No incidents recorded. A CRITICAL alert automatically opens an incident here."/></div>;
  const stepLabels = {STARTED:"START RESPONSE",TEAM_DISPATCHED:"DISPATCH TEAM",EVACUATION_MARKED:"MARK EVACUATION",SAFE_ZONE_OPENED:"OPEN SAFE ZONE",RESOLVED:"MARK RESOLVED"};
  return (
    <div style={{display:"flex",flexDirection:"column",gap:12}}>
      {incidents.map(inc=>{
        const node = nodes.find(n=>n.id===inc.nodeId);
        const nearest = nearestSafeZone(inc.nodeId);
        const wf = responseWorkflows[inc.id];
        const stepIndex = wf ? wf.stepIndex : -1;
        return (
          <div key={inc.id} className="psa-panel" style={{padding:16}}>
            <div style={{display:"flex",justifyContent:"space-between"}}>
              <div>
                <div style={{display:"flex",gap:8,alignItems:"center"}}>
                  <b>{inc.id}</b><span className={"badge "+(inc.status==="RESOLVED"?"b-safe":"b-critical")}>{inc.status}</span>
                  <span style={{fontSize:11,color:"var(--muted2)"}}>{inc.startTime}</span>
                </div>
                <div style={{fontSize:13,marginTop:4}}>{HAZARD_LABEL[inc.hazard]} · {inc.location} · Node {inc.nodeId}</div>
                <div style={{fontSize:11.5,color:"var(--muted)",marginTop:2}}>Peak risk {inc.peakRisk}/100 · Peak confidence {inc.peakConfidence}%</div>
              </div>
              {nearest && (
                <div className="psa-panel2" style={{padding:"8px 12px",fontSize:11.5,minWidth:190}}>
                  <div style={{color:"var(--muted)"}}>Recommended Safe Zone</div>
                  <b>{nearest.name}</b>
                  <div style={{color:"var(--muted2)"}}>Capacity {nearest.occupancy}/{nearest.capacity}</div>
                </div>
              )}
            </div>

            <div style={{display:"flex",gap:8,marginTop:12,flexWrap:"wrap"}}>
              {stepIndex<0 ? (
                <button className="psa-btn psa-btn-primary" disabled={!canRespond} onClick={()=>startResponse(inc.id)}>START RESPONSE</button>
              ) : WORKFLOW_STEPS.map((s,i)=>(
                <button key={s} className={"psa-btn "+(s==="RESOLVED"?"psa-btn-safe":"")}
                  disabled={!canRespond || i <= stepIndex || i !== stepIndex+1}
                  style={{opacity: i<=stepIndex?0.4:1}}
                  onClick={()=>advanceWorkflow(inc.id, s)}>
                  {i<=stepIndex ? <CheckCircle2 size={12}/> : null} {stepLabels[s]}
                </button>
              ))}
            </div>

            {inc.actionsTaken.length>0 && (
              <div style={{marginTop:10,fontSize:11,color:"var(--muted)"}}>
                Timeline: {inc.actionsTaken.join(" → ")}
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}

/* ================= ANALYTICS ================= */
function AnalyticsView({nodes,incidents,alerts,analyticsRange,setAnalyticsRange,exportIncidentsCSV}){
  const rangeLimit = {"1H":15,"6H":40,"24H":60,"7D":60,"CUSTOM":60}[analyticsRange];
  const combined = useMemo(()=>{
    const map = {};
    nodes.forEach(n=>n.history.slice(-rangeLimit).forEach(h=>{
      if(!map[h.tick]) map[h.tick] = {tick:h.tick};
      map[h.tick]["risk_"+n.id.replace("PS-NODE-","N")] = h.riskScore;
    }));
    return Object.values(map).sort((a,b)=>a.tick-b.tick);
  },[nodes,rangeLimit]);

  const alertsByHazard = ["FLOOD","FIRE","AIR","LANDSLIDE"].map(h=>({name:HAZARD_LABEL[h],value:alerts.filter(a=>a.hazard===h).length}));
  const alertsBySeverity = ["WATCH","WARNING","HIGH","CRITICAL"].map(l=>({name:l,value:alerts.filter(a=>a.level===l).length}));
  const PIE_COLORS = ["#33C7E8","#E8B93B","#F0863F","#E9455A"];

  return (
    <div style={{display:"flex",flexDirection:"column",gap:14}}>
      <div className="psa-panel" style={{padding:14}}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
          <PanelHeader title="Risk Score vs Time (all nodes)" />
          <div style={{display:"flex",gap:6}}>
            {["1H","6H","24H","7D","CUSTOM"].map(r=>(
              <button key={r} className="psa-btn" style={{padding:"4px 9px",background:analyticsRange===r?"#152230":undefined}} onClick={()=>setAnalyticsRange(r)}>{r}</button>
            ))}
          </div>
        </div>
        <ResponsiveContainer width="100%" height={240}>
          <LineChart data={combined}>
            <CartesianGrid strokeDasharray="3 3" stroke="#1E2A38"/>
            <XAxis dataKey="tick" stroke="#57667A" fontSize={10}/>
            <YAxis stroke="#57667A" fontSize={10} domain={[0,100]}/>
            <Tooltip contentStyle={{background:"#101720",border:"1px solid #1E2A38",fontSize:11}}/>
            <Legend wrapperStyle={{fontSize:10}}/>
            {nodes.slice(0,6).map((n,i)=>(
              <Line key={n.id} type="monotone" dataKey={"risk_"+n.id.replace("PS-NODE-","N")} stroke={["#33C7E8","#33C97A","#E8B93B","#F0863F","#E9455A","#8b5cf6"][i%6]} dot={false} strokeWidth={1.6}/>
            ))}
          </LineChart>
        </ResponsiveContainer>
      </div>

      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14}}>
        <div className="psa-panel" style={{padding:14}}>
          <PanelHeader title="Alerts by Hazard"/>
          <ResponsiveContainer width="100%" height={200}>
            <BarChart data={alertsByHazard}>
              <XAxis dataKey="name" stroke="#57667A" fontSize={10}/>
              <YAxis stroke="#57667A" fontSize={10} allowDecimals={false}/>
              <Tooltip contentStyle={{background:"#101720",border:"1px solid #1E2A38",fontSize:11}}/>
              <Bar dataKey="value" fill="#33C7E8" radius={[4,4,0,0]}/>
            </BarChart>
          </ResponsiveContainer>
        </div>
        <div className="psa-panel" style={{padding:14}}>
          <PanelHeader title="Alerts by Severity"/>
          <ResponsiveContainer width="100%" height={200}>
            <PieChart>
              <Pie data={alertsBySeverity} dataKey="value" nameKey="name" outerRadius={75}>
                {alertsBySeverity.map((e,i)=><Cell key={i} fill={PIE_COLORS[i]}/>)}
              </Pie>
              <Tooltip contentStyle={{background:"#101720",border:"1px solid #1E2A38",fontSize:11}}/>
              <Legend wrapperStyle={{fontSize:10}}/>
            </PieChart>
          </ResponsiveContainer>
        </div>
      </div>

      <div className="psa-panel" style={{padding:14}}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
          <PanelHeader title={`Incident History (${incidents.length})`}/>
          <button className="psa-btn" onClick={exportIncidentsCSV}><Download size={13}/> Export CSV</button>
        </div>
        {!incidents.length ? <EmptyState text="No incidents recorded yet."/> : (
          <table style={{width:"100%",fontSize:11.5,borderCollapse:"collapse"}}>
            <thead><tr style={{color:"var(--muted)",borderBottom:"1px solid var(--line)",textAlign:"left"}}>
              {["ID","Hazard","Location","Peak Risk","Status","Resolution"].map(h=><th key={h} style={{padding:"6px 8px"}}>{h}</th>)}
            </tr></thead>
            <tbody>{incidents.map(i=>(
              <tr key={i.id} style={{borderBottom:"1px solid var(--line)"}}>
                <td style={{padding:"6px 8px"}}>{i.id}</td><td style={{padding:"6px 8px"}}>{HAZARD_LABEL[i.hazard]}</td>
                <td style={{padding:"6px 8px"}}>{i.location}</td><td style={{padding:"6px 8px"}} className="mono">{i.peakRisk}</td>
                <td style={{padding:"6px 8px"}}><span className={"badge "+(i.status==="RESOLVED"?"b-safe":"b-critical")}>{i.status}</span></td>
                <td style={{padding:"6px 8px"}}>{i.resolutionTime||"—"}</td>
              </tr>
            ))}</tbody>
          </table>
        )}
      </div>
    </div>
  );
}

/* ================= SIMULATION CENTER ================= */
function SimulationView({scenario,setScenario,simRunning,setSimRunning,simSpeed,setSimSpeed,tick,nodes,estimateTimeToCritical,runSensorAnomalyDemo}){
  const scenarios = [
    {id:"NORMAL",label:"Normal Conditions",icon:CheckCircle2},
    {id:"FLOOD",label:"Flood Scenario",icon:Droplets},
    {id:"FIRE",label:"Forest Fire Scenario",icon:Flame},
    {id:"POLLUTION",label:"Pollution Scenario",icon:Wind},
    {id:"HEAT",label:"Heat Wave Scenario",icon:ThermometerSun},
    {id:"LANDSLIDE",label:"Landslide Scenario",icon:Mountain},
    {id:"INDUSTRIAL",label:"Industrial Leak Scenario",icon:CircleAlert},
  ];
  const activeNodes = nodes.filter(n=>n.zone===SCENARIO_ZONE[scenario]);
  const floodNode = nodes.find(n=>(n.type==="FLOOD") && n.zone===SCENARIO_ZONE.FLOOD);

  return (
    <div style={{display:"flex",flexDirection:"column",gap:14}}>
      <div className="psa-panel" style={{padding:16}}>
        <PanelHeader title="Select Scenario"/>
        <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:10}}>
          {scenarios.map(s=>{
            const Icon=s.icon;
            return (
              <button key={s.id} onClick={()=>setScenario(s.id)}
                className="psa-panel2" style={{padding:"12px",textAlign:"left",border: scenario===s.id?"1px solid var(--cyan)":"1px solid var(--line)",cursor:"pointer"}}>
                <Icon size={16} color={scenario===s.id?"var(--cyan)":"var(--muted)"}/>
                <div style={{marginTop:6,fontSize:12,fontWeight:600}}>{s.label}</div>
              </button>
            );
          })}
        </div>

        <div style={{display:"flex",gap:10,alignItems:"center",marginTop:16}}>
          {!simRunning ? (
            <button className="psa-btn psa-btn-primary" onClick={()=>setSimRunning(true)}><Play size={13}/> Start Simulation</button>
          ) : (
            <button className="psa-btn" onClick={()=>setSimRunning(false)}><Pause size={13}/> Pause</button>
          )}
          <button className="psa-btn" onClick={()=>setSimRunning(true)}>Resume</button>
          <button className="psa-btn psa-btn-danger" onClick={()=>{setSimRunning(false); setScenario("NORMAL");}}><RotateCcw size={13}/> Reset</button>
          <div style={{marginLeft:"auto",display:"flex",gap:6,alignItems:"center"}}>
            <span style={{fontSize:11,color:"var(--muted)"}}>Speed</span>
            {[1,2,5,10].map(s=>(
              <button key={s} className="psa-btn" style={{padding:"4px 9px",background:simSpeed===s?"#152230":undefined}} onClick={()=>setSimSpeed(s)}>{s}x</button>
            ))}
          </div>
        </div>
        <div style={{marginTop:10,fontSize:11.5,color:"var(--muted)"}}>Tick: <span className="mono">{tick}</span> · Affected zone: <b>{SCENARIO_ZONE[scenario]||"—"}</b></div>
      </div>

      {scenario==="FLOOD" && floodNode && (
        <div className="psa-panel" style={{padding:16}}>
          <PanelHeader title="Predictive Flood System"/>
          <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:10}}>
            <StatBox label="Current Water Level" value={floodNode.telemetry.waterLevel.toFixed(1)+" cm"} />
            <StatBox label="Rainfall" value={floodNode.telemetry.rainfall.toFixed(1)+" mm/hr"} />
            <StatBox label="Flood Risk" value={floodNode.riskScore+"/100"} color={LEVEL_COLOR[floodNode.riskLevel]} />
            <StatBox label="Est. Time to Critical" value={estimateTimeToCritical(floodNode)||"—"} />
          </div>
        </div>
      )}

      <div className="psa-panel" style={{padding:16}}>
        <PanelHeader title={`Live Telemetry — ${SCENARIO_ZONE[scenario]||"All zones stable"}`}/>
        {!activeNodes.length ? <EmptyState text="Select a scenario to see affected sensor nodes here."/> : (
          <ResponsiveContainer width="100%" height={220}>
            <LineChart data={activeNodes[0]?.history || []}>
              <CartesianGrid strokeDasharray="3 3" stroke="#1E2A38"/>
              <XAxis dataKey="tick" stroke="#57667A" fontSize={10}/>
              <YAxis stroke="#57667A" fontSize={10}/>
              <Tooltip contentStyle={{background:"#101720",border:"1px solid #1E2A38",fontSize:11}}/>
              <Legend wrapperStyle={{fontSize:10}}/>
              <Line type="monotone" dataKey="riskScore" name="Risk" stroke="#E9455A" dot={false} strokeWidth={2}/>
              <Line type="monotone" dataKey="waterLevel" name="Water Level" stroke="#33C7E8" dot={false} strokeWidth={1.5}/>
              <Line type="monotone" dataKey="temperature" name="Temp" stroke="#F0863F" dot={false} strokeWidth={1.5}/>
              <Line type="monotone" dataKey="pm25" name="PM2.5" stroke="#E8B93B" dot={false} strokeWidth={1.5}/>
              <Line type="monotone" dataKey="soilMoisture" name="Soil Moisture" stroke="#33C97A" dot={false} strokeWidth={1.5}/>
            </LineChart>
          </ResponsiveContainer>
        )}
      </div>
    </div>
  );
}
function StatBox({label,value,color}){
  return <div className="psa-panel2" style={{padding:"10px 12px"}}>
    <div style={{fontSize:10.5,color:"var(--muted)"}}>{label}</div>
    <div className="mono" style={{fontSize:16,fontWeight:700,marginTop:4,color:color||"var(--text)"}}>{value}</div>
  </div>;
}

/* ================= DEVICES ================= */
function DevicesView({nodes}){
  const [attempts,setAttempts] = useState([]);
  function simulateUnauthorized(){
    setAttempts(prev=>[{id:"ATT-"+Math.random().toString(36).slice(2,7),time:new Date().toLocaleTimeString(),
      nodeId:"UNKNOWN-"+Math.floor(Math.random()*999),reason:"Invalid device token"},...prev].slice(0,20));
  }
  return (
    <div style={{display:"flex",flexDirection:"column",gap:14}}>
      <div className="psa-panel" style={{padding:14}}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
          <PanelHeader title="Device Authentication"/>
          <button className="psa-btn" onClick={simulateUnauthorized}>Simulate Unauthorized Attempt</button>
        </div>
        <table style={{width:"100%",fontSize:11.5,borderCollapse:"collapse"}}>
          <thead><tr style={{color:"var(--muted)",borderBottom:"1px solid var(--line)",textAlign:"left"}}>
            <th style={{padding:"6px 8px"}}>Node ID</th><th style={{padding:"6px 8px"}}>Device Key</th><th style={{padding:"6px 8px"}}>Firmware</th><th style={{padding:"6px 8px"}}>Status</th>
          </tr></thead>
          <tbody>{nodes.map(n=>(
            <tr key={n.id} style={{borderBottom:"1px solid var(--line)"}}>
              <td style={{padding:"6px 8px"}}>{n.id}</td>
              <td style={{padding:"6px 8px"}} className="mono">tok_{n.id.toLowerCase().replace(/-/g,"")}••••</td>
              <td style={{padding:"6px 8px"}}>{n.firmware}</td>
              <td style={{padding:"6px 8px"}}><span className={"badge "+(n.connectivity==="ONLINE"?"b-safe":"b-critical")}>{n.connectivity==="ONLINE"?"AUTHORIZED":"OFFLINE"}</span></td>
            </tr>
          ))}</tbody>
        </table>
      </div>
      <div className="psa-panel" style={{padding:14}}>
        <PanelHeader title="Rejected / Unauthorized Telemetry Attempts"/>
        {!attempts.length ? <EmptyState text="No unauthorized access attempts logged."/> : (
          <div style={{display:"flex",flexDirection:"column",gap:6}}>
            {attempts.map(a=>(
              <div key={a.id} className="psa-panel2" style={{padding:"7px 10px",fontSize:11.5,display:"flex",justifyContent:"space-between"}}>
                <span><span className="mono" style={{color:"var(--muted2)"}}>{a.time}</span> — {a.nodeId} rejected</span>
                <span style={{color:"var(--red)"}}>{a.reason}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

/* ================= SYSTEM HEALTH ================= */
function HealthView({systemStatus,simulateConnectivityLoss,restoreConnectivity,kpi,nodes,queuedEvents}){
  const services = [
    {name:"REST API",status:systemStatus==="OFFLINE"?"OFFLINE":"HEALTHY",latency:12+Math.round(Math.random()*8)},
    {name:"Database",status:systemStatus==="OFFLINE"?"OFFLINE":"HEALTHY",latency:4+Math.round(Math.random()*4)},
    {name:"MQTT Broker",status:systemStatus==="OFFLINE"?"OFFLINE":systemStatus==="SYNCING"?"WARNING":"HEALTHY",latency:8+Math.round(Math.random()*6)},
    {name:"WebSocket Stream",status:systemStatus==="ONLINE"?"HEALTHY":systemStatus==="SYNCING"?"WARNING":"OFFLINE",latency:6+Math.round(Math.random()*4)},
    {name:"AI Risk Engine",status:"HEALTHY",latency:2+Math.round(Math.random()*3)},
    {name:"Map Service",status:"HEALTHY",latency:15+Math.round(Math.random()*10)},
    {name:"Notification Service",status:"HEALTHY (local)",latency:3+Math.round(Math.random()*3)},
  ];
  return (
    <div style={{display:"flex",flexDirection:"column",gap:14}}>
      <div className="psa-panel" style={{padding:16,display:"flex",justifyContent:"space-between",alignItems:"center"}}>
        <div>
          <div style={{fontSize:13,fontWeight:700}}>System Status: <span style={{color: systemStatus==="ONLINE"?"var(--green)":systemStatus==="SYNCING"?"var(--yellow)":"var(--red)"}}>{systemStatus}</span></div>
          <div style={{fontSize:11,color:"var(--muted)",marginTop:2}}>Edge Mode demo: simulate a connectivity loss to see local processing & queued sync take over.</div>
        </div>
        {systemStatus==="ONLINE" ? (
          <button className="psa-btn psa-btn-danger" onClick={simulateConnectivityLoss}>Simulate Connectivity Loss</button>
        ) : systemStatus==="OFFLINE" ? (
          <button className="psa-btn psa-btn-safe" onClick={restoreConnectivity}>Restore Connection</button>
        ) : <span className="badge b-warning">SYNCING…</span>}
      </div>

      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:10}}>
        <StatBox label="Connected Nodes" value={`${kpi.online}/${kpi.total}`}/>
        <StatBox label="Messages / sec" value={(kpi.online*0.7).toFixed(1)}/>
        <StatBox label="Queued Events" value={queuedEvents}/>
        <StatBox label="Last Heartbeat" value={systemStatus!=="OFFLINE"?new Date().toLocaleTimeString():"—"}/>
      </div>

      <div className="psa-panel" style={{padding:14}}>
        <PanelHeader title="Service Health"/>
        <table style={{width:"100%",fontSize:12,borderCollapse:"collapse"}}>
          <thead><tr style={{color:"var(--muted)",borderBottom:"1px solid var(--line)",textAlign:"left"}}>
            <th style={{padding:"6px 8px"}}>Service</th><th style={{padding:"6px 8px"}}>Status</th><th style={{padding:"6px 8px"}}>Latency</th>
          </tr></thead>
          <tbody>{services.map(s=>(
            <tr key={s.name} style={{borderBottom:"1px solid var(--line)"}}>
              <td style={{padding:"6px 8px"}}>{s.name}</td>
              <td style={{padding:"6px 8px"}}><span className={"badge "+(s.status.includes("HEALTHY")?"b-safe":s.status==="WARNING"?"b-warning":"b-critical")}>{s.status}</span></td>
              <td style={{padding:"6px 8px"}} className="mono">{s.status==="OFFLINE"?"—":s.latency+" ms"}</td>
            </tr>
          ))}</tbody>
        </table>
      </div>
    </div>
  );
}

/* ================= SETTINGS ================= */
function SettingsView({role,setRole,notifications}){
  return (
    <div style={{display:"flex",flexDirection:"column",gap:14}}>
      <div className="psa-panel" style={{padding:16}}>
        <PanelHeader title="User Role (route protection demo)"/>
        <div style={{display:"flex",gap:8}}>
          {["ADMIN","AUTHORITY","OPERATOR","VIEWER"].map(r=>(
            <button key={r} className="psa-btn" style={{background:role===r?"#152230":undefined,borderColor:role===r?"var(--cyan)":undefined}} onClick={()=>setRole(r)}>{r}</button>
          ))}
        </div>
        <div style={{fontSize:11.5,color:"var(--muted)",marginTop:10,lineHeight:1.6}}>
          ADMIN: full access. AUTHORITY: alerts, incidents, response, maps. OPERATOR: sensors, simulation, monitoring.
          VIEWER: read-only dashboard. Switching roles above actually disables the corresponding action buttons across the app.
        </div>
      </div>
      <div className="psa-panel" style={{padding:14}}>
        <PanelHeader title="Notification Log"/>
        {!notifications.length ? <EmptyState text="No notifications sent yet."/> : (
          <div style={{display:"flex",flexDirection:"column",gap:6,maxHeight:320,overflow:"auto"}}>
            {notifications.map(n=>(
              <div key={n.id} className="psa-panel2" style={{padding:"7px 10px",fontSize:11.5,display:"flex",justifyContent:"space-between"}}>
                <span><span className="mono" style={{color:"var(--muted2)"}}>{n.time}</span> [{n.channel}] {n.recipient}: {n.message}</span>
                <span className={"badge "+(n.status==="DELIVERED"?"b-safe":"b-warning")}>{n.status.replace(/_/g," ")}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}
