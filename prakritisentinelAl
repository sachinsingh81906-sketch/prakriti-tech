      {!!badge && <span style={{background:"var(--red)",color:"#fff",fontSize:10,fontWeight:700,borderRadius:20,padding:"1px 6px"}}>{badge}</span>}
    </button>
  );
}

/* ================= DASHBOARD ================= */
function DashboardView({kpi,nodes,alerts,eventLog,flashKey,setActiveView,setSelectedNodeId,mapFilter,setMapFilter,filteredMapNodes,safeZones}){
  return (
    <div style={{display:"flex",flexDirection:"column",gap:16}}>
      <div style={{display:"grid",gridTemplateColumns:"repeat(8,1fr)",gap:10}}>
        <KpiCard label="Total Nodes" value={kpi.total} icon={Radio} color="var(--cyan)" />
        <KpiCard label="Online" value={kpi.online} icon={Wifi} color="var(--green)" />
        <KpiCard label="Offline" value={kpi.offline} icon={WifiOff} color="var(--muted)" />
        <KpiCard label="Active Alerts" value={kpi.activeAlerts} icon={Bell} color="var(--yellow)" />
        <KpiCard label="Critical Alerts" value={kpi.criticalAlerts} icon={AlertTriangle} color="var(--red)" />
        <KpiCard label="Areas At Risk" value={kpi.atRisk} icon={Users} color="var(--orange)" />
        <KpiCard label="Hazards Detected" value={kpi.hazardsDetected} icon={Gauge} color="var(--cyan)" />
        <KpiCard label="Network Health" value={kpi.networkHealth+"%"} icon={Signal} color="var(--green)" />
      </div>

      <div style={{display:"grid",gridTemplateColumns:"1.5fr 1fr",gap:14}}>
        <div className="psa-panel" style={{padding:14}}>
          <PanelHeader title="Live Environment Map" action={<button className="psa-btn" onClick={()=>setActiveView("map")}>Open full map <ChevronRight size={12}/></button>} />
          <StylizedMap nodes={filteredMapNodes} onSelect={setSelectedNodeId} safeZones={safeZones} height={320} />
        </div>
        <div className="psa-panel" style={{padding:14,display:"flex",flexDirection:"column"}}>
          <PanelHeader title="Real-Time Event Log" />
          <div className="psa-scroll" style={{flex:1,overflow:"auto",maxHeight:290,display:"flex",flexDirection:"column",gap:6}}>
            {eventLog.slice(0,25).map((e,i)=>(
              <div key={i} className={i===0?"tick":""} style={{fontSize:11.5,padding:"6px 8px",borderRadius:6,background:"#0D131B",border:"1px solid var(--line)"}}>
                <span className="mono" style={{color:"var(--muted2)"}}>{e.time}</span>{" "}
                <b style={{color: e.severity==="CRITICAL"?"var(--red)":e.severity==="HIGH"?"var(--orange)":e.severity==="WARNING"?"var(--yellow)":"var(--cyan)"}}>{e.source}</b>
                {" — "}{e.message}
              </div>
