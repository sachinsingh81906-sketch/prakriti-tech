/* ================= NODE DETAIL MODAL ================= */
function NodeDetailModal({node,onClose,estimateTimeToCritical}){
  const eta = node.type==="FLOOD"||node.type==="MULTI" ? estimateTimeToCritical(node) : null;
  return (
    <div style={{position:"fixed",inset:0,background:"rgba(4,7,11,.65)",display:"flex",alignItems:"center",justifyContent:"center",zIndex:60}} onClick={onClose}>
      <div className="psa-panel" style={{width:560,maxHeight:"85vh",overflow:"auto",padding:20}} onClick={e=>e.stopPropagation()}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12}}>
          <div>
            <div style={{fontSize:15,fontWeight:700}}>{node.id} · {node.name}</div>
            <div style={{fontSize:11,color:"var(--muted)"}}>{node.zone} · {HAZARD_LABEL[node.type]} node · Firmware {node.firmware}</div>
          </div>
          <button className="psa-btn" onClick={onClose}>Close</button>
        </div>
        <div style={{display:"flex",gap:8,marginBottom:14}}>
          <span className={"badge "+LEVEL_BADGE[node.riskLevel]}>{node.riskLevel}</span>
          <span className="badge b-watch">Confidence {node.confidence}%</span>
          <span className={"badge "+(node.fusionStatus==="ANOMALY_SUSPECTED"?"b-warning":"b-safe")}>{node.fusionStatus}</span>
          <span className={"badge "+(node.connectivity==="ONLINE"?"b-safe":"b-critical")}>{node.connectivity}</span>
        </div>
        {eta && <div className="psa-panel2" style={{padding:"9px 12px",marginBottom:12,fontSize:12}}>
          <b>Estimated Time to Critical Level:</b> {eta==="REACHED" ? "Critical level already reached." : eta} <span style={{color:"var(--muted2)"}}>(prototype linear projection — label as estimate)</span>
        </div>}
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8,marginBottom:14}}>
          {Object.entries(node.telemetry).map(([k,v])=>(
            <div key={k} className="psa-panel2" style={{padding:"7px 10px",display:"flex",justifyContent:"space-between"}}>
              <span style={{color:"var(--muted)",fontSize:11,textTransform:"capitalize"}}>{k.replace(/([A-Z])/g," $1")}</span>
              <span className="mono" style={{fontWeight:700,fontSize:12}}>{v.toFixed(1)}</span>
            </div>
          ))}
        </div>
        {node.factors?.length>0 && (
          <div style={{marginBottom:10}}>
            <div style={{fontSize:12,fontWeight:700,marginBottom:6}}>Why did AI give this score? ({node.riskScore}/100)</div>
            {node.factors.map((f,i)=>(
              <div key={i} style={{display:"flex",justifyContent:"space-between",fontSize:11.5,padding:"4px 0",borderBottom:"1px solid var(--line)"}}>
                <span style={{color:"var(--muted)"}}>{f.label}</span><span className="mono">+{f.contribution}</span>
              </div>
            ))}
          </div>
        )}
        {node.history.length>2 && (
          <ResponsiveContainer width="100%" height={140}>
            <LineChart data={node.history}>
              <XAxis dataKey="tick" stroke="#57667A" fontSize={9}/>
              <YAxis stroke="#57667A" fontSize={9} domain={[0,100]}/>
              <Tooltip contentStyle={{background:"#101720",border:"1px solid #1E2A38",fontSize:11}}/>
              <Line type="monotone" dataKey="riskScore" stroke="#33C7E8" dot={false} strokeWidth={2}/>
            </LineChart>
          </ResponsiveContainer>
        )}
      </div>
    </div>
  );
}

