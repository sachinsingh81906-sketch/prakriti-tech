          </div>
        </div>
      </div>

      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14}}>
        <div className="psa-panel" style={{padding:14}}>
          <PanelHeader title="Active Alerts" action={<button className="psa-btn" onClick={()=>setActiveView("alerts")}>View all <ChevronRight size={12}/></button>} />
          {alerts.filter(a=>a.status!=="RESOLVED").length===0 && <EmptyState text="No active alerts. All monitored zones are within safe parameters." />}
          <div style={{display:"flex",flexDirection:"column",gap:8}}>
            {alerts.filter(a=>a.status!=="RESOLVED").slice(0,4).map(a=>(
              <div key={a.id} className="psa-panel2" style={{padding:"9px 12px",display:"flex",justifyContent:"space-between",alignItems:"center"}}>
                <div>
                  <span className={"badge "+LEVEL_BADGE[a.level]}>{a.level}</span>
                  <span style={{marginLeft:8,fontWeight:600}}>{HAZARD_LABEL[a.hazard]} · {a.location}</span>
                  <div style={{fontSize:11,color:"var(--muted)",marginTop:2}}>{a.reason}</div>
                </div>
                <div className="mono" style={{fontSize:13,fontWeight:700,color:LEVEL_COLOR[a.level]}}>{a.riskScore}</div>
              </div>
            ))}
          </div>
        </div>
        <div className="psa-panel" style={{padding:14}}>
          <PanelHeader title="Fleet Risk Overview" />
          <ResponsiveContainer width="100%" height={200}>
            <BarChart data={nodes.map(n=>({name:n.id.replace("PS-NODE-",""),risk:n.riskScore, fill:LEVEL_COLOR[n.riskLevel]}))}>
              <CartesianGrid strokeDasharray="3 3" stroke="#1E2A38" />
              <XAxis dataKey="name" stroke="#57667A" fontSize={10} />
              <YAxis stroke="#57667A" fontSize={10} domain={[0,100]} />
              <Tooltip contentStyle={{background:"#101720",border:"1px solid #1E2A38",fontSize:11}} />
              <Bar dataKey="risk" radius={[4,4,0,0]}>
                {nodes.map((n,i)=><Cell key={i} fill={LEVEL_COLOR[n.riskLevel]} />)}
              </Bar>
            </BarChart>
          </ResponsiveContainer>
        </div>
      </div>
    </div>
  );
}

