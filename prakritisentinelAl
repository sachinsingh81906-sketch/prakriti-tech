/* ---------------- SCENARIO PROGRESSION ---------------- */
// Given progress 0..1 (eased), returns target deltas to blend telemetry toward.
function ease(p){ return p<0.5 ? 2*p*p : 1-Math.pow(-2*p+2,2)/2; }

function scenarioTarget(scenario, baseType, p){
  const e = ease(clamp(p,0,1));
  switch(scenario){
    case "FLOOD":
      return { rainfall:5+e*80, waterLevel:15+e*82, humidity:55+e*30, soilMoisture:30+e*55 };
    case "FIRE":
      return { temperature:27+e*28, humidity:60-e*45, smoke:2+e*85, gas:2+e*10 };
    case "POLLUTION":
      return { pm25:25+e*220, pm10:35+e*260, gas:2+e*22, humidity:55-e*10 };
    case "HEAT":
      return { temperature:30+e*20, humidity:55-e*35 };
    case "LANDSLIDE":
      return { rainfall:5+e*60, soilMoisture:32+e*62, vibration:0.03+e*0.85, waterLevel:15+e*10 };
    case "INDUSTRIAL":
      return { gas:2+e*70, smoke:2+e*20, pm25:25+e*90 };
    default:
      return null;
  }
}

const SCENARIO_RELEVANT_TYPES = {
  FLOOD:["FLOOD","MULTI"], FIRE:["FIRE","MULTI"], POLLUTION:["AIR","MULTI"],
  HEAT:["FIRE","AIR","MULTI"], LANDSLIDE:["LANDSLIDE","MULTI"], INDUSTRIAL:["AIR","MULTI"], NORMAL:[],
};
const SCENARIO_ZONE = { FLOOD:"Zone A", FIRE:"Zone B", POLLUTION:"Zone C", LANDSLIDE:"Zone D", HEAT:"Zone B", INDUSTRIAL:"Zone C" };
const TOTAL_TICKS_TO_PEAK = 34;

/* ---------------- RISK ENGINE ---------------- */
// Deterministic + statistical multi-factor scoring. Each factor is normalized 0-100
// then combined with fixed weights. Returns {score, factors:[{label, contribution}]}
function scoreFlood(t, prevT){
  const levelNorm = clamp(t.waterLevel,0,100);
  const rate = prevT ? clamp((t.waterLevel-prevT.waterLevel)*9,0,100) : 0;
  const rainNorm = clamp(t.rainfall*1.1,0,100);
  const soilNorm = clamp((t.soilMoisture-25)*1.3,0,100);
  const factors = [
    {label:"Water level", weight:.45, norm:levelNorm},
    {label:"Rate of rise", weight:.25, norm:rate},
    {label:"Rainfall intensity", weight:.20, norm:rainNorm},
    {label:"Soil saturation", weight:.10, norm:soilNorm},
  ];
  return finalizeFactors(factors);
}
function scoreFire(t){
  const tempNorm = clamp((t.temperature-25)*3.2,0,100);
  const humDeficit = clamp((60-t.humidity)*1.8,0,100);
  const smokeNorm = clamp(t.smoke*1.15,0,100);
  const gasNorm = clamp(t.gas*4,0,100);
  const factors = [
    {label:"Temperature", weight:.35, norm:tempNorm},
    {label:"Humidity deficit", weight:.20, norm:humDeficit},
    {label:"Smoke concentration", weight:.32, norm:smokeNorm},
    {label:"Gas level", weight:.13, norm:gasNorm},
  ];
  return finalizeFactors(factors);
}
function scoreAir(t){
  const pm25Norm = clamp(t.pm25*0.42,0,100);
  const pm10Norm = clamp(t.pm10*0.34,0,100);
  const gasNorm = clamp(t.gas*3.5,0,100);
  const factors = [
    {label:"PM2.5 concentration", weight:.45, norm:pm25Norm},
    {label:"PM10 concentration", weight:.32, norm:pm10Norm},
    {label:"Gas / CO level", weight:.23, norm:gasNorm},
  ];
  return finalizeFactors(factors);
}
function scoreLandslide(t, prevT){
  const soilNorm = clamp((t.soilMoisture-25)*1.35,0,100);
  const vibNorm = clamp(t.vibration*110,0,100);
  const rainNorm = clamp(t.rainfall*1.1,0,100);
  const soilRate = prevT ? clamp((t.soilMoisture-prevT.soilMoisture)*14,0,100) : 0;
  const factors = [
    {label:"Soil moisture", weight:.30, norm:soilNorm},
    {label:"Ground vibration", weight:.35, norm:vibNorm},
    {label:"Rainfall", weight:.20, norm:rainNorm},
    {label:"Soil moisture rate", weight:.15, norm:soilRate},
  ];
  return finalizeFactors(factors);
}
function finalizeFactors(factors){
  let score=0;
  const withContribution = factors.map(f=>{
    const contribution = Math.round(f.weight*f.norm);
    score += contribution;
    return {label:f.label, contribution};
  });
  return { score: clamp(Math.round(score),0,100), factors: withContribution };
}

function computeHazardScores(node, prevTelemetry){
  const t = node.telemetry;
  const out = {};
  if(node.type==="FLOOD" || node.type==="MULTI") out.FLOOD = scoreFlood(t, prevTelemetry);
  if(node.type==="FIRE" || node.type==="MULTI") out.FIRE = scoreFire(t);
  if(node.type==="AIR"  || node.type==="MULTI") out.AIR = scoreAir(t);
  if(node.type==="LANDSLIDE" || node.type==="MULTI") out.LANDSLIDE = scoreLandslide(t, prevTelemetry);
  return out;
}

function primaryHazard(hazardScores){
  let best=null, bestScore=-1;
  for(const k in hazardScores){ if(hazardScores[k].score>bestScore){ bestScore=hazardScores[k].score; best=k; } }
  return best;
}

/* ---------------- MAIN APP ---------------- */
export default function PrakritiSentinelAI(){
  const [nodes,setNodes] = useState(makeInitialNodes);
  const [alerts,setAlerts] = useState([]);
  const [incidents,setIncidents] = useState([]);
  const [notifications,setNotifications] = useState([]);
  const [eventLog,setEventLog] = useState([{ time:new Date().toLocaleTimeString(), source:"SYSTEM", message:"Prakriti Sentinel AI command center initialized. All nodes reporting baseline safe conditions." }]);
  const [safeZones,setSafeZones] = useState(SAFE_ZONE_INIT);
  const [scenario,setScenario] = useState("NORMAL");
  const [simRunning,setSimRunning] = useState(false);
  const [simSpeed,setSimSpeed] = useState(1);
  const [tick,setTick] = useState(0);
  const [activeView,setActiveView] = useState("dashboard");
  const [selectedNodeId,setSelectedNodeId] = useState(null);
  const [mapFilter,setMapFilter] = useState("ALL");
  const [role,setRole] = useState("ADMIN");
  const [systemStatus,setSystemStatus] = useState("ONLINE");
  const [queuedEvents,setQueuedEvents] = useState(0);
  const [responseWorkflows,setResponseWorkflows] = useState({}); // incidentId -> steps state
  const [analyticsRange,setAnalyticsRange] = useState("1H");
  const [toast,setToast] = useState(null);
  const [demoRunning,setDemoRunning] = useState(false);
  const [demoStepIdx,setDemoStepIdx] = useState(0);
  const [flashKey,setFlashKey] = useState(0);
  const [newNodeForm,setNewNodeForm] = useState(null);
  const [editingNodeId,setEditingNodeId] = useState(null);
  const [historyNodeId,setHistoryNodeId] = useState(null);

  const tickRef = useRef(0);
  const prevTelemetryRef = useRef({});

  const canEdit = role==="ADMIN" || role==="OPERATOR";
  const canRespond = role==="ADMIN" || role==="AUTHORITY";

  function pushEvent(source, message, severity){
    const entry = { time:new Date().toLocaleTimeString(), source, message, severity: severity||"INFO" };
    if(systemStatus==="OFFLINE"){
      setQueuedEvents(q=>q+1);
    }
    setEventLog(prev=>[entry, ...prev].slice(0,120));
  }
  function pushNotification(recipient, message, severity){
    setNotifications(prev=>[{ id:"N-"+Math.random().toString(36).slice(2,8), recipient, message, severity,
      time:new Date().toLocaleTimeString(), channel:"IN_APP", status:"DELIVERED" },
      { id:"N-"+Math.random().toString(36).slice(2,8), recipient, message, severity,
      time:new Date().toLocaleTimeString(), channel:"SMS", status:"PROVIDER_NOT_CONFIGURED" },
      { id:"N-"+Math.random().toString(36).slice(2,8), recipient, message, severity,
      time:new Date().toLocaleTimeString(), channel:"EMAIL", status:"PROVIDER_NOT_CONFIGURED" },
      ...prev].slice(0,80));
  }
  function showToast(msg, tone){ setToast({msg,tone}); setTimeout(()=>setToast(null),3200); }

  /* ---------- SIMULATION LOOP ---------- */
  useEffect(()=>{
    if(!simRunning || systemStatus==="OFFLINE") return;
    const interval = setInterval(()=>{
      tickRef.current += 1;
      setTick(tickRef.current);
      setFlashKey(k=>k+1);
      advanceSimulation(tickRef.current);
    }, 1400/simSpeed);
    return ()=>clearInterval(interval);
    // eslint-disable-next-line
  },[simRunning, simSpeed, scenario, systemStatus]);

  function advanceSimulation(t){
    setNodes(prevNodes=>{
      const zoneAffected = SCENARIO_ZONE[scenario];
      const relevantTypes = SCENARIO_RELEVANT_TYPES[scenario]||[];
      const progress = t / TOTAL_TICKS_TO_PEAK;

      const updated = prevNodes.map(node=>{
        if(node.connectivity==="OFFLINE") return node;
        let telemetry = { ...node.telemetry };
        const prevT = prevTelemetryRef.current[node.id];

        const isAffected = scenario!=="NORMAL" && node.zone===zoneAffected && relevantTypes.includes(node.type);

        if(isAffected){
          const target = scenarioTarget(scenario, node.type, progress);
          if(target){
            Object.keys(target).forEach(k=>{ telemetry[k] = telemetry[k]*0.55 + target[k]*0.45 + (Math.random()-0.5)*1.5; });
          }
        } else {
          // gentle drift back to baseline + small noise for realism
          const base = baselineTelemetry(node.type);
          Object.keys(base).forEach(k=>{
            if(k==="battery") return;
            telemetry[k] = telemetry[k]*0.9 + base[k]*0.1 + (Math.random()-0.5)*0.6;
          });
        }

        // forced one-tick anomaly (Sensor Anomaly Demo)
        if(node.forcedAnomaly){
          telemetry.waterLevel = node.type==="FLOOD"||node.type==="MULTI" ? 96 : telemetry.waterLevel;
          telemetry.pm25 = node.type==="AIR" ? 310 : telemetry.pm25;
          telemetry.gas = node.type==="AIR" ? 45 : telemetry.gas;
        }
        telemetry.battery = clamp(telemetry.battery - (isAffected?0.06:0.015),1,100);

        const hazardScores = computeHazardScores({...node, telemetry}, prevT);
        const haz = primaryHazard(hazardScores);
        let riskScore=0, factors=[];
        if(haz){ riskScore = hazardScores[haz].score; factors = hazardScores[haz].factors; }

        // neighbor correlation for sensor fusion
        const neighbors = prevNodes.filter(n=>n.id!==node.id && n.zone===node.zone);
        const neighborAvgRisk = neighbors.length ? neighbors.reduce((s,n)=>s+n.riskScore,0)/neighbors.length : 0;

        let fusionStatus = "VALIDATED";
        let confidence = 58;
        const isolatedSpike = node.forcedAnomaly && riskScore>=55 && neighborAvgRisk < riskScore*0.35;

        if(isolatedSpike){
          fusionStatus = "ANOMALY_SUSPECTED";
          confidence = 34;
          riskScore = Math.min(riskScore, 40); // downgrade displayed risk after fusion check
        } else if(isAffected){
          const agreement = neighbors.length ? clamp(neighborAvgRisk/Math.max(riskScore,1),0,1) : 0.5;
          confidence = clamp(58 + agreement*28 + (t>6?10:0), 40, 98);
          fusionStatus = neighbors.length && neighborAvgRisk>15 ? "VALIDATED" : "VALIDATED (SINGLE NODE)";
        } else {
          confidence = 60;
        }

        const riskLevel = levelFromScore(riskScore);
        const newHistoryEntry = { tick:t, time:new Date().toLocaleTimeString(), riskScore, waterLevel:telemetry.waterLevel,
          temperature:telemetry.temperature, pm25:telemetry.pm25, soilMoisture:telemetry.soilMoisture, rainfall:telemetry.rainfall };
        const history = [...node.history, newHistoryEntry].slice(-60);

        prevTelemetryRef.current[node.id] = telemetry;

        return { ...node, telemetry, riskScore, riskLevel, confidence:Math.round(confidence),
          fusionStatus, factors, primaryHazard:haz, history, lastSeen:Date.now(), forcedAnomaly:false,
          hazardScores };
      });

      // events / alerts / incidents based on transitions
      updated.forEach((node, i)=>{
        const prevNode = prevNodes[i];
        if(!prevNode) return;
        if(node.fusionStatus==="ANOMALY_SUSPECTED" && prevNode.fusionStatus!=="ANOMALY_SUSPECTED"){
          pushEvent(node.id, `Reported anomalous reading with no neighbor correlation — flagged POSSIBLE SENSOR FAULT.`, "WARNING");
          pushEvent("SENSOR FUSION", `Event rejected by sensor fusion for ${node.id}. No alert generated.`, "INFO");
        }
        if(node.riskLevel!==prevNode.riskLevel && node.fusionStatus!=="ANOMALY_SUSPECTED"){
          pushEvent(node.id, `${HAZARD_LABEL[node.primaryHazard]||node.type} risk moved ${prevNode.riskLevel} \u2192 ${node.riskLevel} (score ${node.riskScore}).`,
            node.riskLevel==="CRITICAL"?"CRITICAL":node.riskLevel==="HIGH"?"HIGH":"INFO");
        }
        const crossedAlertLevel = (node.riskLevel==="HIGH"||node.riskLevel==="CRITICAL") &&
          (prevNode.riskLevel!=="HIGH" && prevNode.riskLevel!=="CRITICAL") && node.fusionStatus!=="ANOMALY_SUSPECTED";
        if(crossedAlertLevel){
          createAlert(node);
        }
        if(node.riskLevel==="CRITICAL" && prevNode.riskLevel!=="CRITICAL" && node.fusionStatus!=="ANOMALY_SUSPECTED"){
          createIncident(node);
        }
      });

      return updated;
    });
  }

  function createAlert(node){
    const hazard = node.primaryHazard;
    const id = "AL-"+Math.random().toString(36).slice(2,7).toUpperCase();
    const reasonParts = (node.factors||[]).slice().sort((a,b)=>b.contribution-a.contribution).slice(0,3)
      .map(f=>f.label);
    const alert = {
      id, hazard, nodeId:node.id, nodeName:node.name, location:node.zone, riskScore:node.riskScore,
      confidence:node.confidence, timestamp:new Date().toLocaleString(),
      reason: reasonParts.join(" + "), recommendedActions: recommendedActions(hazard, node.riskLevel),
      status:"ACTIVE", level:node.riskLevel,
    };
    setAlerts(prev=>[alert, ...prev]);
    pushEvent("ALERT ENGINE", `${node.riskLevel} ${HAZARD_LABEL[hazard]} alert generated for ${node.id} (${node.zone}). Risk ${node.riskScore}/100.`, node.riskLevel);
    pushNotification("Zone Authorities", `${node.riskLevel} ${HAZARD_LABEL[hazard]} alert — ${node.zone}. Risk ${node.riskScore}/100.`, node.riskLevel);
  }

  function createIncident(node){
    const hazard = node.primaryHazard;
    setIncidents(prev=>{
      const alreadyOpen = prev.find(inc=>inc.nodeId===node.id && inc.status!=="RESOLVED");
      if(alreadyOpen) return prev;
      const id = "INC-"+String(prev.length+1).padStart(3,"0");
      const incident = {
        id, hazard, nodeId:node.id, location:node.zone, startTime:new Date().toLocaleString(),
        peakRisk:node.riskScore, peakConfidence:node.confidence, affectedNodes:[node.id],
        actionsTaken:[], status:"OPEN", resolutionTime:null,
      };
      pushEvent("INCIDENT", `Incident ${id} opened — CRITICAL ${HAZARD_LABEL[hazard]} at ${node.zone}.`, "CRITICAL");
      return [incident, ...prev];
    });
  }

  function recommendedActions(hazard, level){
    const base = {
      FLOOD:["Alert zone authorities","Notify nearby communities","Open nearest safe zone","Begin evacuation protocol","Dispatch trained response team"],
      FIRE:["Alert forest fire control room","Deploy ground reconnaissance","Restrict access to affected ridge","Prepare firebreak resources","Notify nearby settlements"],
      AIR:["Issue public health advisory","Restrict outdoor activity in zone","Notify pollution control board","Increase monitoring frequency"],
      LANDSLIDE:["Alert zone authorities","Restrict movement on slope road","Prepare evacuation of at-risk structures","Dispatch geotechnical team"],
    };
    return base[hazard] || ["Alert zone authorities","Increase monitoring frequency"];
  }

  /* ---------- ALERT ACTIONS ---------- */
  function acknowledgeAlert(id){
    setAlerts(prev=>prev.map(a=>a.id===id?{...a,status:"ACKNOWLEDGED"}:a));
    pushEvent("OPERATOR", `Alert ${id} acknowledged.`, "INFO");
    showToast("Alert acknowledged","cyan");
  }
  function escalateAlert(id){
    setAlerts(prev=>prev.map(a=>a.id===id?{...a,level:"CRITICAL",status:"ACTIVE"}:a));
    pushEvent("OPERATOR", `Alert ${id} escalated to CRITICAL.`, "CRITICAL");
    showToast("Alert escalated to CRITICAL","red");
  }
  function resolveAlert(id){
    setAlerts(prev=>prev.map(a=>a.id===id?{...a,status:"RESOLVED"}:a));
    pushEvent("OPERATOR", `Alert ${id} marked resolved.`, "INFO");
    showToast("Alert resolved","green");
  }

  /* ---------- RESCUE / RESPONSE WORKFLOW ---------- */
  const WORKFLOW_STEPS = ["STARTED","TEAM_DISPATCHED","EVACUATION_MARKED","SAFE_ZONE_OPENED","RESOLVED"];
  function startResponse(incidentId){
    setResponseWorkflows(prev=>({...prev,[incidentId]:{stepIndex:0}}));
    setIncidents(prev=>prev.map(i=>i.id===incidentId?{...i,status:"RESPONSE_STARTED",actionsTaken:[...i.actionsTaken,"Response started"]}:i));
    pushEvent("RESPONSE", `Response workflow started for ${incidentId}.`, "INFO");
  }
  function advanceWorkflow(incidentId, stepName){
    setResponseWorkflows(prev=>({...prev,[incidentId]:{stepIndex:(prev[incidentId]?.stepIndex??0)+1}}));
    setIncidents(prev=>prev.map(i=>i.id===incidentId?{...i,actionsTaken:[...i.actionsTaken, stepName]}:i));
    pushEvent("RESPONSE", `${incidentId}: ${stepName.replace(/_/g," ")}.`, "INFO");
    if(stepName==="SAFE_ZONE_OPENED"){
      const inc = incidents.find(i=>i.id===incidentId);
      if(inc){
        const nearest = nearestSafeZone(inc.nodeId);
        if(nearest){
          setSafeZones(prev=>prev.map(z=>z.id===nearest.id?{...z,occupancy:clamp(z.occupancy+Math.round(80+Math.random()*120),0,z.capacity),
            status: (z.occupancy > z.capacity*0.85)?"NEAR CAPACITY":z.status}:z));
        }
      }
    }
    if(stepName==="RESOLVED"){
      setIncidents(prev=>prev.map(i=>i.id===incidentId?{...i,status:"RESOLVED",resolutionTime:new Date().toLocaleString()}:i));
      pushEvent("INCIDENT", `Incident ${incidentId} resolved.`, "INFO");
      showToast(`Incident ${incidentId} resolved`,"green");
    }
  }
  function nearestSafeZone(nodeId){
    const node = nodes.find(n=>n.id===nodeId);
    if(!node) return null;
    const candidates = safeZones.filter(z=>z.status!=="FULL" && z.status!=="CLOSED");
    if(!candidates.length) return null;
    return candidates.reduce((best,z)=>{
      const d = Math.hypot(z.x-node.x, z.y-node.y);
      return (!best || d<best.d) ? {...z, d} : best;
    }, null);
  }

  /* ---------- NODE ACTIONS ---------- */
  function disableNode(id){
    setNodes(prev=>prev.map(n=>n.id===id?{...n,connectivity:n.connectivity==="OFFLINE"?"ONLINE":"OFFLINE"}:n));
    const n = nodes.find(x=>x.id===id);
    pushEvent(id, n?.connectivity==="OFFLINE" ? "Node brought back online." : "Node manually disabled by operator.", "INFO");
  }
  function restartNode(id){
    setNodes(prev=>prev.map(n=>n.id===id?{...n, telemetry:baselineTelemetry(n.type), riskScore:5, riskLevel:"SAFE",
      confidence:60, connectivity:"ONLINE", history:[]}:n));
    pushEvent(id, "Node restarted — telemetry reset to baseline safe values.", "INFO");
    showToast(`${id} restarted`,"cyan");
  }
  function sendTestData(id){
    setNodes(prev=>prev.map(n=>n.id===id?{...n, forcedAnomaly:true}:n));
    pushEvent(id, "Manual test telemetry injected by operator (anomaly probe).", "INFO");
    showToast(`Test data sent to ${id}`,"cyan");
  }
  function deleteNode(id){
    setNodes(prev=>prev.filter(n=>n.id!==id));
    pushEvent("SYSTEM", `Node ${id} removed from fleet by ${role}.`, "WARNING");
  }
  function addNode(form){
    const id = "PS-NODE-"+String(nodes.length+1).padStart(2,"0")+"X";
    setNodes(prev=>[...prev,{
      id, name:form.name||"New Node", type:form.type, zone:form.zone, x:Number(form.x)||50, y:Number(form.y)||50,
      firmware:"v2.3.1", connectivity:"ONLINE", signal:80, lastSeen:Date.now(),
      telemetry:baselineTelemetry(form.type), history:[], riskScore:5, riskLevel:"SAFE",
      confidence:60, fusionStatus:"VALIDATED", factors:[], forcedAnomaly:false,
    }]);
    pushEvent("SYSTEM", `New node ${id} (${form.type}) provisioned in ${form.zone}.`, "INFO");
    setNewNodeForm(null);
  }
  function saveEditNode(id, form){
    setNodes(prev=>prev.map(n=>n.id===id?{...n,name:form.name,type:form.type,zone:form.zone}:n));
    setEditingNodeId(null);
    pushEvent(id, "Node configuration updated.", "INFO");
  }

  /* ---------- DEMO / ANOMALY TRIGGERS ---------- */
  function runSensorAnomalyDemo(){
    const candidates = nodes.filter(n=>n.connectivity==="ONLINE" && (n.type==="FLOOD"||n.type==="AIR"||n.type==="MULTI"));
    if(!candidates.length) return;
    const target = candidates[Math.floor(Math.random()*candidates.length)];
    setNodes(prev=>prev.map(n=>n.id===target.id?{...n,forcedAnomaly:true}:n));
    if(!simRunning) setSimRunning(true);
    pushEvent("DEMO", `Sensor Anomaly Demo: injecting isolated extreme reading on ${target.id}.`, "WARNING");
    showToast("Anomaly injected — watch Sensor Fusion reject it","yellow");
  }
  function startJudgingDemo(){
    setDemoRunning(true);
    setDemoStepIdx(0);
    setScenario("FLOOD");
    setSimSpeed(3);
    setSimRunning(true);
    setActiveView("dashboard");
    pushEvent("DEMO", "Judging Demo started — Flood scenario, 3x speed.", "INFO");
  }
  function stopJudgingDemo(){
    setDemoRunning(false);
    setSimRunning(false);
  }
  const DEMO_STEPS = [
    "Normal environment — all nodes reporting safe baseline conditions.",
    "Rainfall begins increasing across Zone A river sensors.",
    "Water level rises steadily at PS-NODE-01 and PS-NODE-02.",
    "Multiple nodes in Zone A detect the same abnormal trend.",
    "AI risk engine validates the event via sensor fusion.",
    "Flood risk score climbs into WARNING / HIGH range.",
    "Live map highlights the expanding risk zone in Zone A.",
    "Critical alert generated once risk crosses 85/100.",
    "Nearest available safe zone is recommended automatically.",
    "Rescue & Response workflow is ready to dispatch a team.",
  ];
  useEffect(()=>{
    if(!demoRunning) return;
    const t = setInterval(()=> setDemoStepIdx(i=> Math.min(i+1, DEMO_STEPS.length-1)), 4500);
    return ()=>clearInterval(t);
  },[demoRunning]);

  /* ---------- SYSTEM HEALTH / EDGE MODE ---------- */
  function simulateConnectivityLoss(){
    setSystemStatus("OFFLINE");
    setSimRunning(false);
    pushEvent("SYSTEM", "Connectivity lost — entering EDGE MODE. Data will be processed locally and queued.", "CRITICAL");
  }
  function restoreConnectivity(){
    setSystemStatus("SYNCING");
    setTimeout(()=>{
      setSystemStatus("ONLINE");
      pushEvent("SYSTEM", `Connectivity restored — synchronized ${queuedEvents} queued events.`, "INFO");
      setQueuedEvents(0);
      showToast("Connection restored — data synced","green");
    }, 1600);
  }

  /* ---------- CSV EXPORT ---------- */
  function exportIncidentsCSV(){
    const header = ["ID","Hazard","Location","Start Time","Peak Risk","Peak Confidence","Affected Nodes","Status","Resolution Time"];
    const rows = incidents.map(i=>[i.id,i.hazard,i.location,i.startTime,i.peakRisk,i.peakConfidence,i.affectedNodes.join("|"),i.status,i.resolutionTime||""]);
    const csv = [header, ...rows].map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(",")).join("\n");
    const blob = new Blob([csv], {type:"text/csv"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "prakriti_incidents.csv"; a.click();
    URL.revokeObjectURL(url);
    pushEvent("ANALYTICS", "Incident history exported to CSV.", "INFO");
  }

  /* ---------- DERIVED / MEMOIZED ---------- */
  const kpi = useMemo(()=>{
    const online = nodes.filter(n=>n.connectivity==="ONLINE").length;
    return {
      total: nodes.length, online, offline: nodes.length-online,
      activeAlerts: alerts.filter(a=>a.status==="ACTIVE").length,
      criticalAlerts: alerts.filter(a=>a.level==="CRITICAL" && a.status!=="RESOLVED").length,
      atRisk: nodes.filter(n=>n.riskLevel==="HIGH"||n.riskLevel==="CRITICAL").length,
      hazardsDetected: new Set(nodes.filter(n=>n.riskLevel!=="SAFE"&&n.riskLevel!=="WATCH").map(n=>n.primaryHazard)).size,
      networkHealth: Math.round((online/nodes.length)*100),
    };
  },[nodes,alerts]);

  const filteredMapNodes = useMemo(()=>{
    if(mapFilter==="ALL") return nodes;
    if(mapFilter==="CRITICAL") return nodes.filter(n=>n.riskLevel==="CRITICAL");
    return nodes.filter(n=>n.type===mapFilter || (n.type==="MULTI" && n.hazardScores && n.hazardScores[mapFilter]));
  },[nodes,mapFilter]);

  const selectedNode = nodes.find(n=>n.id===selectedNodeId);

  /* ---------- ESTIMATED TIME TO CRITICAL (flood) ---------- */
  function estimateTimeToCritical(node){
    if(!node || node.history.length<3) return null;
    const h = node.history.slice(-5);
    const deltaLevel = h[h.length-1].waterLevel - h[0].waterLevel;
    const deltaTicks = h.length-1;
    const perTick = deltaLevel/deltaTicks;
    if(perTick<=0.05) return null;
    const remaining = 85 - node.telemetry.waterLevel;
    if(remaining<=0) return "REACHED";
    const ticksNeeded = remaining/perTick;
    const secondsPerTick = 1.4/simSpeed;
    const minutes = (ticksNeeded*secondsPerTick)/60;
    return minutes<1 ? "<1 min" : `~${minutes.toFixed(1)} min`;
  }

  return (
    <div className="psa" style={{minHeight:"100vh",display:"flex",fontSize:13}}>
      <style>{THEME}</style>

      {/* SIDEBAR */}
      <div style={{width:220,borderRight:"1px solid var(--line)",display:"flex",flexDirection:"column",padding:"16px 12px",flexShrink:0}}>
        <div style={{display:"flex",alignItems:"center",gap:9,padding:"2px 4px 18px 4px"}}>
          <div style={{width:30,height:30,borderRadius:8,background:"linear-gradient(135deg,#153A48,#0A0E14)",border:"1px solid #2A6478",display:"flex",alignItems:"center",justifyContent:"center"}}>
            <ShieldAlert size={16} color="var(--cyan)" />
          </div>
          <div>
            <div style={{fontWeight:800,fontSize:12.5,letterSpacing:.2}}>PRAKRITI SENTINEL</div>
            <div style={{fontSize:9.5,color:"var(--muted2)",letterSpacing:1}}>AI COMMAND CENTER</div>
          </div>
        </div>
        <NavBtn icon={LayoutDashboard} label="Dashboard" id="dashboard" active={activeView} set={setActiveView} />
        <NavBtn icon={MapPinned} label="Live Map" id="map" active={activeView} set={setActiveView} />
        <NavBtn icon={Radio} label="Sensor Nodes" id="nodes" active={activeView} set={setActiveView} />
        <NavBtn icon={Gauge} label="Hazard Intelligence" id="intel" active={activeView} set={setActiveView} />
        <NavBtn icon={Bell} label="Alerts" id="alerts" active={activeView} set={setActiveView} badge={kpi.activeAlerts} />
        <NavBtn icon={LifeBuoy} label="Rescue / Response" id="rescue" active={activeView} set={setActiveView} />
        <NavBtn icon={BarChart3} label="Analytics" id="analytics" active={activeView} set={setActiveView} />
        <NavBtn icon={FastForward} label="Simulation" id="simulation" active={activeView} set={setActiveView} />
        <NavBtn icon={Lock} label="Device Management" id="devices" active={activeView} set={setActiveView} />
        <NavBtn icon={Server} label="System Health" id="health" active={activeView} set={setActiveView} />
        <NavBtn icon={SettingsIcon} label="Settings" id="settings" active={activeView} set={setActiveView} />

        <div style={{marginTop:"auto",paddingTop:12,borderTop:"1px solid var(--line)"}}>
          <div style={{display:"flex",alignItems:"center",gap:7,fontSize:11,color:"var(--muted)"}}>
            <div style={{width:7,height:7,borderRadius:99,background: systemStatus==="ONLINE"?"var(--green)":systemStatus==="SYNCING"?"var(--yellow)":"var(--red)"}} />
            {systemStatus} {queuedEvents>0 && `· ${queuedEvents} queued`}
          </div>
          <div style={{fontSize:10.5,color:"var(--muted2)",marginTop:4}}>Role: {role}</div>
        </div>
      </div>

      {/* MAIN */}
      <div style={{flex:1,minWidth:0,display:"flex",flexDirection:"column"}}>
        {/* TOP BAR */}
        <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"12px 20px",borderBottom:"1px solid var(--line)"}}>
          <div>
            <div style={{fontSize:15,fontWeight:700}}>{viewTitle(activeView)}</div>
            <div style={{fontSize:11,color:"var(--muted2)"}}>Prototype demonstration data — SIH26178 · Track: Hardware</div>
          </div>
          <div style={{display:"flex",gap:8,alignItems:"center"}}>
            <button className="psa-btn" onClick={runSensorAnomalyDemo}><TestTube2 size={13}/> Sensor Anomaly Demo</button>
            {!demoRunning ? (
              <button className="psa-btn psa-btn-primary" onClick={startJudgingDemo}><Play size={13}/> Judging Demo</button>
            ) : (
              <button className="psa-btn psa-btn-danger" onClick={stopJudgingDemo}><Pause size={13}/> Stop Demo</button>
            )}
          </div>
        </div>

        {demoRunning && (
          <div className="psa-panel2" style={{margin:"10px 20px 0 20px",padding:"10px 14px",display:"flex",alignItems:"center",gap:12}}>
            <Zap size={15} color="var(--cyan)"/>
            <div style={{fontSize:12.5}}><b>Step {demoStepIdx+1}/10:</b> {DEMO_STEPS[demoStepIdx]}</div>
            <div style={{marginLeft:"auto",display:"flex",gap:6}}>
              <button className="psa-btn" style={{padding:"4px 9px"}} onClick={()=>setDemoStepIdx(i=>Math.max(0,i-1))}>Prev</button>
              <button className="psa-btn" style={{padding:"4px 9px"}} onClick={()=>setDemoStepIdx(i=>Math.min(DEMO_STEPS.length-1,i+1))}>Next</button>
            </div>
          </div>
        )}

        <div className="psa-scroll" style={{flex:1,overflow:"auto",padding:20}}>
          {activeView==="dashboard" && (
            <DashboardView kpi={kpi} nodes={nodes} alerts={alerts} eventLog={eventLog} flashKey={flashKey}
              setActiveView={setActiveView} setSelectedNodeId={setSelectedNodeId} mapFilter={mapFilter} setMapFilter={setMapFilter}
              filteredMapNodes={filteredMapNodes} safeZones={safeZones} />
          )}
          {activeView==="map" && (
            <MapView nodes={filteredMapNodes} mapFilter={mapFilter} setMapFilter={setMapFilter}
              setSelectedNodeId={setSelectedNodeId} safeZones={safeZones} />
          )}
          {activeView==="nodes" && (
            <NodesView nodes={nodes} canEdit={canEdit} disableNode={disableNode} restartNode={restartNode}
              sendTestData={sendTestData} deleteNode={deleteNode} newNodeForm={newNodeForm} setNewNodeForm={setNewNodeForm}
              addNode={addNode} editingNodeId={editingNodeId} setEditingNodeId={setEditingNodeId} saveEditNode={saveEditNode}
              historyNodeId={historyNodeId} setHistoryNodeId={setHistoryNodeId} setSelectedNodeId={setSelectedNodeId} />
          )}
          {activeView==="intel" && <IntelView nodes={nodes} />}
          {activeView==="alerts" && (
            <AlertsView alerts={alerts} canRespond={canRespond} acknowledgeAlert={acknowledgeAlert}
              escalateAlert={escalateAlert} resolveAlert={resolveAlert} />
          )}
          {activeView==="rescue" && (
            <RescueView incidents={incidents} nodes={nodes} safeZones={safeZones} canRespond={canRespond}
              startResponse={startResponse} advanceWorkflow={advanceWorkflow} responseWorkflows={responseWorkflows}
              nearestSafeZone={nearestSafeZone} WORKFLOW_STEPS={WORKFLOW_STEPS} />
          )}
          {activeView==="analytics" && (
            <AnalyticsView nodes={nodes} incidents={incidents} alerts={alerts} analyticsRange={analyticsRange}
              setAnalyticsRange={setAnalyticsRange} exportIncidentsCSV={exportIncidentsCSV} />
          )}
          {activeView==="simulation" && (
            <SimulationView scenario={scenario} setScenario={setScenario} simRunning={simRunning} setSimRunning={setSimRunning}
              simSpeed={simSpeed} setSimSpeed={setSimSpeed} tick={tick} nodes={nodes} estimateTimeToCritical={estimateTimeToCritical}
              runSensorAnomalyDemo={runSensorAnomalyDemo} setTick={setTick} tickRef={tickRef} />
          )}
          {activeView==="devices" && <DevicesView nodes={nodes} pushEvent={pushEvent} eventLog={eventLog} />}
          {activeView==="health" && (
            <HealthView systemStatus={systemStatus} simulateConnectivityLoss={simulateConnectivityLoss}
              restoreConnectivity={restoreConnectivity} kpi={kpi} nodes={nodes} queuedEvents={queuedEvents} />
          )}
          {activeView==="settings" && (
            <SettingsView role={role} setRole={setRole} notifications={notifications} />
          )}
        </div>
      </div>

      {selectedNode && <NodeDetailModal node={selectedNode} onClose={()=>setSelectedNodeId(null)} estimateTimeToCritical={estimateTimeToCritical} />}

      {toast && (
        <div style={{position:"fixed",bottom:22,right:22,background:"var(--panel)",border:"1px solid var(--line)",
          borderLeft:`3px solid ${toast.tone==="red"?"var(--red)":toast.tone==="green"?"var(--green)":toast.tone==="yellow"?"var(--yellow)":"var(--cyan)"}`,
          padding:"10px 16px",borderRadius:8,fontSize:12.5,boxShadow:"0 8px 24px rgba(0,0,0,.4)",zIndex:50}}>
          {toast.msg}
        </div>
      )}
    </div>
  );
}

