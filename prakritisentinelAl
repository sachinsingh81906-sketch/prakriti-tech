function baselineTelemetry(type){
  const base = { temperature:26+Math.random()*3, humidity:55+Math.random()*10, rainfall:Math.random()*3,
    waterLevel:12+Math.random()*6, smoke:1+Math.random()*2, pm25:20+Math.random()*10, pm10:30+Math.random()*10,
