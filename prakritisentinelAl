/* ================= STYLIZED MAP ================= */
function StylizedMap({nodes,onSelect,safeZones,height=420}){
  return (
    <svg viewBox="0 0 100 84" style={{width:"100%",height}} preserveAspectRatio="xMidYMid meet">
      <rect x="0" y="0" width="100" height="84" fill="#0B121A" rx="3"/>
      {[...Array(9)].map((_,i)=><line key={"v"+i} x1={i*12} y1="0" x2={i*12} y2="84" stroke="#161F2A" strokeWidth="0.3"/>)}
      {[...Array(7)].map((_,i)=><line key={"h"+i} x1="0" y1={i*12} x2="100" y2={i*12} stroke="#161F2A" strokeWidth="0.3"/>)}
      {["Zone A","Zone B","Zone C","Zone D","Zone E"].map((z,i)=>(
        <text key={z} x={[20,60,72,42,80][i]} y={[20,14,42,58,20][i]} fill="#324459" fontSize="3.4" fontWeight="700">{z}</text>
      ))}
      {safeZones.map(z=>(
        <g key={z.id}>
          <rect x={z.x-2.2} y={z.y-2.2} width="4.4" height="4.4" fill="none" stroke="#33C97A" strokeWidth="0.5" transform={`rotate(45 ${z.x} ${z.y})`} />
          <text x={z.x} y={z.y+5.5} fill="#5C7A6A" fontSize="2.6" textAnchor="middle">{z.name.split(" — ")[0]}</text>
        </g>
      ))}
      {nodes.map(n=>{
        const color = n.connectivity==="OFFLINE" ? "#4A5568" : LEVEL_COLOR[n.riskLevel];
        const Icon = HAZARD_ICON[n.type];
        return (
          <g key={n.id} onClick={()=>onSelect(n.id)} style={{cursor:"pointer"}}>
            {n.riskLevel==="CRITICAL" && <circle cx={n.x} cy={n.y} r="4.2" fill={color} opacity="0.25"><animate attributeName="r" values="3;6;3" dur="1.4s" repeatCount="indefinite"/></circle>}
            <circle cx={n.x} cy={n.y} r="2.1" fill="#0B121A" stroke={color} strokeWidth="1.1" />
            <circle cx={n.x} cy={n.y} r="0.9" fill={color} />
            <text x={n.x} y={n.y-3} fill="#8FA3B8" fontSize="2.4" textAnchor="middle">{n.id.replace("PS-NODE-","N")}</text>
          </g>
        );
      })}
    </svg>
  );
}

